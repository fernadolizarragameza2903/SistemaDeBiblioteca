# Plantilla de variables de entorno. Copiar a .env y completar:
#   cp .env.example .env
# El archivo .env esta en .gitignore: NUNCA se sube al repositorio.

# Base de datos (docker compose)
POSTGRES_DB=sistema_biblioteca
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-esta-contrasena

# Aplicacion
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Perfil prod sin docker compose (opcion A: URL completa | opcion B: por partes)
# DB_URL=jdbc:postgresql://localhost:5432/sistema_biblioteca
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=sistema_biblioteca
# DB_USERNAME=postgres
# DB_PASSWORD=cambia-esta-contrasena
